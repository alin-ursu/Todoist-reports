# Required: get your token from https://todoist.com/prefs/integrations
TODOIST_API_TOKEN=your_todoist_api_token_here

# Optional: timezone for date boundaries and displayed timestamps
# Examples: America/New_York, Europe/London, Asia/Ho_Chi_Minh
# TZ=America/New_York

# Optional: first day of the week for --period last-week (default: monday)
# Use saturday for Sat–Fri weeks (e.g. run every Saturday at 8 AM via cron)
# WEEK_START_DAY=saturday
