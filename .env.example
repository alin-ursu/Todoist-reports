# Required: get your token from https://todoist.com/prefs/integrations
TODOIST_API_TOKEN=your_todoist_api_token_here

# Optional: timezone for date boundaries and displayed timestamps
# Examples: America/New_York, Europe/London, Asia/Ho_Chi_Minh
# TZ=America/New_York

# Optional: first day of the week for --period last-week (default: monday)
# Use saturday for Sat–Fri weeks (e.g. run every Saturday at 8 AM via cron)
# WEEK_START_DAY=saturday

# Email (required for scripts/report_email.py)
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASSWORD=your_smtp_password
# EMAIL_TO=your@email.com
# EMAIL_FROM=your@email.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# Common examples (commented):
# Gmail:   SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true
# Outlook: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_USE_TLS=true
# SSL:     SMTP_PORT=465, SMTP_USE_SSL=true, SMTP_USE_TLS=false

# Hostinger Email (recommended: port 465 SSL):
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=you@yourdomain.com
# SMTP_PASSWORD=your_email_password
# EMAIL_FROM=you@yourdomain.com
# EMAIL_TO=you@yourdomain.com
# SMTP_USE_SSL=true
# SMTP_USE_TLS=false
#
# Hostinger fallback (port 587 STARTTLS) — use ONE block only; do not set both:
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
